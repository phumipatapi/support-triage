# Default: fully offline. No model quality claims apply in mock mode.
DECISION_PROVIDER=mock
# Live hybrid: DECISION_PROVIDER=jev, REPLY_PROVIDER=openai
# Reviewer: DECISION_PROVIDER=openai, REPLY_PROVIDER=openai
REPLY_PROVIDER=mock
# Alternative hybrid: DECISION_PROVIDER=jev, REPLY_PROVIDER=glm
GLM_API_KEY=
GLM_MODEL=glm-4.7
OPENAI_API_KEY=
TYPESAFE_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JEV_MODEL=jev-latest
DATABASE_PATH=storage/triage.sqlite
INCIDENT_DATABASE_PATH=storage/incidents.sqlite
# normal | timeout_after_commit | fail_before_commit
INCIDENT_MODE=normal
INCIDENT_LATENCY_MS=30
