{
  "name": "support-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && node scripts/setup.mjs --start",
    "dev": "tsx watch --env-file-if-exists=.env.local server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.mjs",
    "start": "node --env-file-if-exists=.env.local dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node scripts/demo.mjs",
    "chat": "node scripts/chat.mjs",
    "setup:offline": "npm ci && node scripts/setup.mjs --offline --start",
    "setup:openai": "npm ci && node scripts/setup.mjs --openai --start",
    "eval:openai": "tsx --env-file-if-exists=.env.local evals/run.ts --live --provider=openai",
    "eval:jev": "tsx --env-file-if-exists=.env.local evals/run.ts --live --provider=jev"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^5.2.1",
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
