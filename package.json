{
  "name": "support-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && node scripts/setup.mjs && npm run dev",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "demo": "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "next": "16.3.5",
    "openai": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
